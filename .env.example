# Copie para .env e preencha.

# PostgreSQL (produção). Sem esta variável, o sistema usa PGlite local (desenvolvimento).
# DATABASE_URL=postgres://usuario:senha@host:5432/curalog

# Pasta do banco local PGlite (opcional; padrão: ~/.curalog/pglite)
# PGLITE_DIR=

# Segredo para assinar a sessão (obrigatório em produção). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Usuário administrador criado por `npm run db:seed`
ADMIN_EMAIL=admin@curalog.local
ADMIN_PASSWORD=
